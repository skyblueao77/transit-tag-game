rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap this document once from the Firebase Console after creating
    // the administrator Auth account.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasCurrentGameSession() {
      let configPath = /databases/$(database)/documents/game_config/current;
      return exists(configPath)
        && get(configPath).data.gameSessionId is string
        && get(configPath).data.gameSessionId.size() > 0
        && get(configPath).data.sessionStartedAt is int
        && get(configPath).data.sessionStartedAt >= 0
        && get(configPath).data.sessionSchemaVersion is int
        && get(configPath).data.sessionSchemaVersion >= 2;
    }

    function hasNoCoordinates(data) {
      return !data.keys().hasAny([
        'latitude', 'longitude', 'privateLatitude', 'privateLongitude', 'lastLat', 'lastLng'
      ]);
    }

    function validPlayerCreate(uid) {
      let configPath = /databases/$(database)/documents/game_config/current;
      let data = request.resource.data;
      return signedIn()
        && !isAdmin()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && data.keys().hasOnly([
          'id', 'name', 'role', 'team', 'color', 'score', 'status',
          'gameSessionId', 'invincibleCards', 'lastCompletionId', 'lastStation',
          'protectionZone', 'shinkansenSegmentCount', 'penaltyRevealUntil'
        ])
        && (!data.keys().hasAny(['lastStation']) || (data.lastStation is string && data.lastStation.size() <= 100))
        && (!data.keys().hasAny(['protectionZone']) || data.protectionZone in ['NONE', 'GREEN_CAR', 'SAFE_ZONE'])
        && (!data.keys().hasAny(['shinkansenSegmentCount']) || (data.shinkansenSegmentCount is int && data.shinkansenSegmentCount >= 0))
        && (!data.keys().hasAny(['penaltyRevealUntil']) || (data.penaltyRevealUntil is int && data.penaltyRevealUntil >= 0))
        && data.keys().hasAll([
          'id', 'name', 'role', 'team', 'color', 'score', 'status',
          'gameSessionId', 'invincibleCards'
        ])
        && data.id == uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.role == 'RUNNER'
        && data.team in ['A', 'B']
        && data.color is string
        && data.status == 'ACTIVE'
        && data.score is int
        && data.score == 0
        && data.invincibleCards is int
        && data.invincibleCards == 0
        && data.gameSessionId == get(configPath).data.gameSessionId;
    }

    function isCurrentParticipant(uid) {
      return signedIn()
        && hasCurrentGameSession()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.team in ['A', 'B']
        && get(/databases/$(database)/documents/users/$(uid)).data.gameSessionId
          == get(/databases/$(database)/documents/game_config/current).data.gameSessionId;
    }

    function isPasswordUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isActiveDeadline(deadline) {
      return (deadline is timestamp && request.time < deadline)
        || (deadline is int && request.time.toMillis() < deadline);
    }

    function expiresWithinDeadline(exp, deadline) {
      return (deadline is timestamp && exp <= deadline + duration.value(1, 'm'))
        || (deadline is int && exp.toMillis() <= deadline + 60000);
    }

    match /system/admin_bootstrap {
      allow read: if true;
      allow create: if isPasswordUser()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/system/admin_bootstrap)
        && request.resource.data.keys().hasOnly(['initializedBy', 'initializedAt'])
        && request.resource.data.initializedBy == request.auth.uid
        && request.resource.data.initializedAt is timestamp;
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if (isPasswordUser()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/system/admin_bootstrap)
        && existsAfter(/databases/$(database)/documents/system/admin_bootstrap)
        && getAfter(/databases/$(database)/documents/system/admin_bootstrap).data.initializedBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['role', 'createdAt'])
        && request.resource.data.role == 'admin'
        && request.resource.data.createdAt is timestamp)
        || (isAdmin()
          && request.resource.data.keys().hasOnly(['role', 'createdAt'])
          && request.resource.data.role == 'admin'
          && request.resource.data.createdAt is timestamp);
      allow update, delete: if false;

      match /{subCollection=**} {
        allow read, write: if signedIn() && request.auth.uid == uid && isAdmin();
      }
    }

    match /privateLocations/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && request.resource.data.keys().hasOnly(['gameSessionId', 'latitude', 'longitude', 'updatedAt'])
        && request.resource.data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'updatedAt'])
        && request.resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    function isRevealViewer() {
      return signedIn() && (isAdmin() || isCurrentParticipant(request.auth.uid));
    }

    function validExposedLocationScope(data, uid) {
      let playerPath = /databases/$(database)/documents/users/$(uid);
      let configPath = /databases/$(database)/documents/game_config/current;
      let cfg = get(configPath).data;
      let me = get(playerPath).data;
      return ((!data.keys().hasAny(['revealScope']) || data.revealScope == 'INDIVIDUAL')
          && data.expiresAt <= request.time + duration.value(6, 'm'))
        || (data.revealScope == 'GLOBAL'
          && cfg.keys().hasAny(['locationRevealUntil'])
          && isActiveDeadline(cfg.locationRevealUntil)
          && expiresWithinDeadline(data.expiresAt, cfg.locationRevealUntil)
          && data.expiresAt <= request.time + duration.value(61, 'm'))
        || (data.revealScope == 'TEAM_A'
          && me.team == 'A'
          && cfg.keys().hasAny(['teamARevealUntil'])
          && isActiveDeadline(cfg.teamARevealUntil)
          && expiresWithinDeadline(data.expiresAt, cfg.teamARevealUntil)
          && data.expiresAt <= request.time + duration.value(61, 'm'))
        || (data.revealScope == 'TEAM_B'
          && me.team == 'B'
          && cfg.keys().hasAny(['teamBRevealUntil'])
          && isActiveDeadline(cfg.teamBRevealUntil)
          && expiresWithinDeadline(data.expiresAt, cfg.teamBRevealUntil)
          && data.expiresAt <= request.time + duration.value(61, 'm'))
        || (data.revealScope == 'PENALTY'
          && me.keys().hasAny(['penaltyRevealUntil'])
          && isActiveDeadline(me.penaltyRevealUntil)
          && expiresWithinDeadline(data.expiresAt, me.penaltyRevealUntil)
          && data.expiresAt <= request.time + duration.value(61, 'm'));
    }

    function validExposedLocation(uid) {
      let data = resource.data;
      let playerPath = /databases/$(database)/documents/users/$(uid);
      let configPath = /databases/$(database)/documents/game_config/current;
      return exists(configPath)
        && get(configPath).data.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE']
        && data.keys().hasOnly([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt', 'revealScope'
        ])
        && hasCurrentGameSession()
        && data.gameSessionId == get(configPath).data.gameSessionId
        && data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.capturedAt is timestamp
        && data.expiresAt is timestamp
        && request.time < data.expiresAt
        && (!data.keys().hasAny(['playerId']) || data.playerId == uid)
        && isCurrentParticipant(uid)
        && get(playerPath).data.status != 'EMERGENCY'
        && get(playerPath).data.status != 'RETIRED'
        && validExposedLocationScope(data, uid);
    }

    function validOwnerExposedLocationWrite(uid) {
      let data = request.resource.data;
      let cfg = get(/databases/$(database)/documents/game_config/current).data;
      let me = get(/databases/$(database)/documents/users/$(uid)).data;
      return signedIn()
        && !isAdmin()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && data.keys().hasOnly(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt', 'revealScope', 'playerId'])
        && data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && (!data.keys().hasAny(['playerId']) || data.playerId == uid)
        && data.gameSessionId == cfg.gameSessionId
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.capturedAt is timestamp
        && data.expiresAt is timestamp
        && request.time < data.expiresAt
        && validExposedLocationScope(data, uid)
        && isCurrentParticipant(uid)
        && me.status != 'EMERGENCY'
        && me.status != 'RETIRED'
        && exists(/databases/$(database)/documents/game_config/current)
        && cfg.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE'];
    }

    function ownerMayReplaceSnapshot() {
      let oldData = resource.data;
      let newData = request.resource.data;
      let oldScope = oldData.keys().hasAny(['revealScope']) ? oldData.revealScope : 'INDIVIDUAL';
      let newScope = newData.keys().hasAny(['revealScope']) ? newData.revealScope : 'INDIVIDUAL';
      return !oldData.keys().hasAny(['gameSessionId'])
        || !hasCurrentGameSession()
        || oldData.gameSessionId != get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        || !(oldData.expiresAt is timestamp)
        || oldData.expiresAt <= request.time
        || (oldScope == 'PENALTY'
            && newScope == 'PENALTY'
            && newData.expiresAt >= oldData.expiresAt - duration.value(1, 's'))
        || (oldScope in ['GLOBAL', 'TEAM_A', 'TEAM_B']
            && (newScope == 'PENALTY'
              || (oldScope in ['TEAM_A', 'TEAM_B'] && newScope == 'GLOBAL')
              || (newScope == oldScope && newData.expiresAt > oldData.expiresAt + duration.value(5, 's'))))
        || (oldScope == 'INDIVIDUAL');
    }

    match /exposedLocations/{uid} {
      allow get: if isAdmin()
        || (isRevealViewer()
          && (request.auth.uid == uid
            || resource == null
            || (hasCurrentGameSession()
              && resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
              && get(/databases/$(database)/documents/users/$(uid)).data.status != 'EMERGENCY'
              && get(/databases/$(database)/documents/users/$(uid)).data.status != 'RETIRED')));
      allow list: if isAdmin();
      allow create: if validOwnerExposedLocationWrite(uid);
      allow update: if validOwnerExposedLocationWrite(uid) && ownerMayReplaceSnapshot();
      allow delete: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && existsAfter(/databases/$(database)/documents/users/$(uid))
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.status in ['EMERGENCY', 'RETIRED']);
    }

    function validEmergencyProjectionWrite(uid) {
      return signedIn()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && request.resource.data.keys().hasOnly([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'projectedAt',
          'sourceLocationUpdatedAt', 'expiresAt', 'safetyStatus', 'projectionKind'
        ])
        && request.resource.data.keys().hasAll([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'projectedAt',
          'sourceLocationUpdatedAt', 'expiresAt', 'safetyStatus', 'projectionKind'
        ])
        && request.resource.data.playerId == uid
        && request.resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        && request.resource.data.safetyStatus == 'EMERGENCY'
        && request.resource.data.projectionKind == 'EMERGENCY'
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.status == 'EMERGENCY'
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.projectedAt is timestamp
        && request.resource.data.sourceLocationUpdatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(3, 'm');
    }

    match /emergencyLocationProjections/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if validEmergencyProjectionWrite(uid);
      allow delete: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && existsAfter(/databases/$(database)/documents/users/$(uid))
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.status != 'EMERGENCY');
    }

    function validMissionRewardUpdate(uid, b, a, diff) {
      return diff.hasOnly(['score', 'invincibleCards', 'lastCompletionId'])
        && a.keys().hasAny(['lastCompletionId'])
        && a.lastCompletionId is string
        && !exists(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId))
        && existsAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId))
        && getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.completedBy == uid
        && getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.team == b.team
        && getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.gameSessionId == b.gameSessionId
        && a.lastCompletionId == b.team + '_' + b.gameSessionId + '_' + getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.missionId
        && a.score == b.score + getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.points
        && getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.points > 0
        && getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.points <= 100
        && (a.invincibleCards == b.invincibleCards
            || (a.invincibleCards == b.invincibleCards + 1
                && getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.keys().hasAny(['luckyReward'])
                && getAfter(/databases/$(database)/documents/missionCompletions/$(a.lastCompletionId)).data.luckyReward == true));
    }

    function validSelfUserUpdate(uid) {
      let b = resource.data;
      let a = request.resource.data;
      let diff = a.diff(b).affectedKeys();
      let nowMs = request.time.toMillis();
      let configPath = /databases/$(database)/documents/game_config/current;
      let cfg = get(configPath).data;
      let hasCfg = hasCurrentGameSession();
      let isActivePhase = hasCfg && cfg.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE', 'FINAL_MISSION'];
      let myRole = hasCfg ? (b.team == 'A' ? cfg.teamARole : cfg.teamBRole) : '';
      return signedIn()
        && request.auth.uid == uid
        && hasNoCoordinates(a)
        && a.id == b.id
        && a.team == b.team
        && a.role == b.role
        && a.gameSessionId == b.gameSessionId
        && (
          // 1. Profile name or lastStation update
          (diff.hasOnly(['name']) && a.name is string && a.name.size() > 0 && a.name.size() <= 80)
          || (diff.hasOnly(['lastStation']) && a.lastStation is string && a.lastStation.size() <= 100)
          || (diff.hasOnly(['name', 'lastStation'])
              && a.name is string && a.name.size() > 0 && a.name.size() <= 80
              && a.lastStation is string && a.lastStation.size() <= 100)
          // 1b. Protection Zone declaration (NONE, GREEN_CAR, SAFE_ZONE)
          || (diff.hasOnly(['protectionZone'])
              && isActivePhase
              && b.status == 'ACTIVE'
              && myRole == 'RUNNER'
              && a.protectionZone in ['NONE', 'GREEN_CAR', 'SAFE_ZONE'])
          // 1c. Shinkansen tracker updates
          || (diff.hasOnly(['shinkansenStartTime', 'shinkansenSegmentCount'])
              && isActivePhase
              && b.status == 'ACTIVE'
              && myRole == 'RUNNER'
              && a.shinkansenSegmentCount is int
              && a.shinkansenSegmentCount >= 0
              && (
                ((!b.keys().hasAny(['shinkansenStartTime']) || b.shinkansenStartTime == 0 || b.shinkansenStartTime == null)
                  && a.shinkansenStartTime is int
                  && a.shinkansenStartTime >= nowMs - 60000
                  && a.shinkansenStartTime <= nowMs + 60000
                  && a.shinkansenSegmentCount == 0)
                || ((a.shinkansenStartTime == 0 || a.shinkansenStartTime == null)
                    && b.keys().hasAny(['shinkansenStartTime'])
                    && b.shinkansenStartTime is int
                    && nowMs <= b.shinkansenStartTime + 60000
                    && (!b.keys().hasAny(['shinkansenSegmentCount']) || b.shinkansenSegmentCount == 0)
                    && a.shinkansenSegmentCount == 0)
              ))
          || (diff.hasOnly(['shinkansenSegmentCount'])
              && isActivePhase
              && b.status == 'ACTIVE'
              && myRole == 'RUNNER'
              && b.keys().hasAny(['shinkansenStartTime'])
              && b.shinkansenStartTime is int
              && b.shinkansenStartTime > 0
              && a.shinkansenSegmentCount is int
              && a.shinkansenSegmentCount == (b.keys().hasAny(['shinkansenSegmentCount']) && b.shinkansenSegmentCount is int ? b.shinkansenSegmentCount : 0) + 1)
          || (diff.hasOnly(['shinkansenStartTime'])
              && isActivePhase
              && b.status == 'ACTIVE'
              && myRole == 'RUNNER'
              && (
                ((!b.keys().hasAny(['shinkansenStartTime']) || b.shinkansenStartTime == 0 || b.shinkansenStartTime == null)
                  && a.shinkansenStartTime is int
                  && a.shinkansenStartTime >= nowMs - 60000
                  && a.shinkansenStartTime <= nowMs + 60000)
                || ((a.shinkansenStartTime == 0 || a.shinkansenStartTime == null)
                    && b.keys().hasAny(['shinkansenStartTime'])
                    && b.shinkansenStartTime is int
                    && nowMs <= b.shinkansenStartTime + 60000
                    && (!b.keys().hasAny(['shinkansenSegmentCount']) || b.shinkansenSegmentCount == 0))
              ))
          // 2. Waiting resume upon expiry
          || (diff.hasOnly(['status', 'waitingUntil', 'shinkansenStartTime'])
              && b.status == 'WAITING' && a.status == 'ACTIVE'
              && b.waitingUntil is int && b.waitingUntil <= nowMs
              && a.waitingUntil == 0
              && (a.shinkansenStartTime == null || a.shinkansenStartTime == 0))
          // 3. Manual waiting start (60 min default or postShinkansenWaitMinutes + 60s tolerance)
          || (diff.hasOnly(['status', 'waitingUntil', 'shinkansenStartTime'])
              && isActivePhase
              && myRole == 'RUNNER'
              && b.status == 'ACTIVE' && a.status == 'WAITING'
              && (a.shinkansenStartTime == null || a.shinkansenStartTime == 0)
              && a.waitingUntil is int && a.waitingUntil > nowMs
              && (a.waitingUntil <= nowMs + 3660000
                || (cfg.keys().hasAny(['postShinkansenWaitMinutes'])
                    && cfg.postShinkansenWaitMinutes is int
                    && cfg.postShinkansenWaitMinutes >= 1
                    && cfg.postShinkansenWaitMinutes <= 180
                    && a.waitingUntil <= nowMs + cfg.postShinkansenWaitMinutes * 60000 + 60000))
              && a.waitingUntil <= nowMs + 10860000)
          // 4. Powerup invincibility card use (30 min max duration + 60s tolerance)
          || (diff.hasOnly(['invincibleCards', 'invincibleUntil'])
              && isActivePhase
              && myRole == 'RUNNER'
              && b.status == 'ACTIVE'
              && (!b.keys().hasAny(['invincibleUntil']) || !(b.invincibleUntil is int) || b.invincibleUntil <= nowMs)
              && b.invincibleCards is int && b.invincibleCards >= 1
              && a.invincibleCards == b.invincibleCards - 1
              && a.invincibleUntil is int && a.invincibleUntil > nowMs
              && a.invincibleUntil <= nowMs + 1860000)
          // 5. Safety action: Emergency or Retire
          || (diff.hasOnly(['status', 'waitingUntil', 'shinkansenStartTime', 'invincibleUntil'])
              && b.status != 'RETIRED'
              && a.status in ['EMERGENCY', 'RETIRED']
              && a.waitingUntil == 0
              && (a.shinkansenStartTime == null || a.shinkansenStartTime == 0)
              && a.invincibleUntil == 0)
          // 6. Mission completion reward: only evaluated if diff has 'score'
          || (diff.hasAny(['score']) && validMissionRewardUpdate(uid, b, a, diff))
        );
    }

    function validCaptureWaitingBound(cfg, targetTimeMs, nowMs) {
      return targetTimeMs is int
        && targetTimeMs > nowMs
        && targetTimeMs <= nowMs + 7260000
        && (targetTimeMs <= nowMs + 1860000
          || (cfg.keys().hasAny(['captureWaitMinutes'])
            && cfg.captureWaitMinutes is int
            && cfg.captureWaitMinutes >= 1
            && cfg.captureWaitMinutes <= 120
            && targetTimeMs <= nowMs + cfg.captureWaitMinutes * 60000 + 60000));
    }

    function validParticipantCaptureUpdate(uid) {
      let b = resource.data;
      let a = request.resource.data;
      let diff = a.diff(b).affectedKeys();
      let configPath = /databases/$(database)/documents/game_config/current;
      let curConfig = get(configPath).data;
      let afterConfig = getAfter(configPath).data;
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let myRole = me.team == 'A' ? curConfig.teamARole : curConfig.teamBRole;
      let nowMs = request.time.toMillis();
      let isSurvival = curConfig.keys().hasAny(['victoryMode']) && curConfig.victoryMode == 'SURVIVAL';
      return signedIn()
        && isCurrentParticipant(request.auth.uid)
        && hasNoCoordinates(a)
        && a.id == b.id
        && a.name == b.name
        && a.team == b.team
        && a.role == b.role
        && a.score == b.score
        && a.gameSessionId == b.gameSessionId
        && a.gameSessionId == curConfig.gameSessionId
        && (!b.keys().hasAny(['color']) || a.color == b.color)
        && curConfig.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE', 'FINAL_MISSION']
        && myRole == 'ONI'
        && me.status == 'ACTIVE'
        && (!isSurvival ? afterConfig.teamARole != curConfig.teamARole : afterConfig.teamARole == curConfig.teamARole)
        && b.status != 'EMERGENCY'
        && b.status != 'RETIRED'
        && (
          // Survival mode: only captured target becomes CAPTURED without waiting
          (isSurvival
           && b.team != me.team
           && afterConfig.lastCaptureTargetId == uid
           && ((me.team == 'A' && afterConfig.teamAScore == curConfig.teamAScore + 50 && afterConfig.teamBScore == curConfig.teamBScore)
             || (me.team == 'B' && afterConfig.teamBScore == curConfig.teamBScore + 50 && afterConfig.teamAScore == curConfig.teamAScore))
           && b.status == 'ACTIVE'
           && (!b.keys().hasAny(['invincibleUntil']) || !(b.invincibleUntil is int) || b.invincibleUntil <= nowMs)
           && (!b.keys().hasAny(['protectionZone']) || b.protectionZone == 'NONE')
           && diff.hasOnly(['status', 'waitingUntil', 'invincibleUntil'])
           && a.status == 'CAPTURED'
           && a.waitingUntil == 0
           && a.invincibleUntil == 0)
          // Branch A: Captured side (opposing team b.team != me.team)
          // All players transition to WAITING (capped at 30 min + 60s or captureWaitMinutes) with invincibility cleared
          || (!isSurvival
              && b.team != me.team
              && diff.hasOnly(['status', 'waitingUntil', 'invincibleUntil'])
              && a.status == 'WAITING'
              && a.waitingUntil is int
              && a.waitingUntil > nowMs
              && (a.waitingUntil <= nowMs + 1860000
                || (curConfig.keys().hasAny(['captureWaitMinutes'])
                  && curConfig.captureWaitMinutes is int
                  && curConfig.captureWaitMinutes >= 1
                  && curConfig.captureWaitMinutes <= 120
                  && a.waitingUntil <= nowMs + curConfig.captureWaitMinutes * 60000 + 60000))
              && a.waitingUntil <= nowMs + 7260000
              && a.invincibleUntil == 0)
          // Branch B: Capturing side (own team b.team == me.team, including captor)
          // All players transition to ACTIVE, clear waiting, and receive exactly +1 invincibleCard
          || (!isSurvival
              && b.team == me.team
              && diff.hasOnly(['status', 'waitingUntil', 'invincibleCards'])
              && a.status == 'ACTIVE'
              && a.waitingUntil == 0
              && a.invincibleCards == (b.keys().hasAny(['invincibleCards']) ? b.invincibleCards : 0) + 1)
        );
    }

    match /users/{uid} {
      allow get: if signedIn() && (isAdmin() || isCurrentParticipant(request.auth.uid) || request.auth.uid == uid);
      allow list: if signedIn() && (isAdmin() || isCurrentParticipant(request.auth.uid));
      allow create: if validPlayerCreate(uid);
      allow update: if (isAdmin() && hasNoCoordinates(request.resource.data))
        || validSelfUserUpdate(uid)
        || validParticipantCaptureUpdate(uid);
      allow delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    function validMissionCompletionCreate(completionId) {
      let data = request.resource.data;
      let configPath = /databases/$(database)/documents/game_config/current;
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let missionPath = /databases/$(database)/documents/missions/$(data.missionId);
      let config = get(configPath).data;
      let mission = get(missionPath).data;
      return signedIn()
        && isCurrentParticipant(request.auth.uid)
        && hasCurrentGameSession()
        && data.keys().hasOnly([
          'gameSessionId', 'missionId', 'team', 'completedBy',
          'points', 'luckyReward', 'isFinalMission', 'completedAt'
        ])
        && data.keys().hasAll([
          'gameSessionId', 'missionId', 'team', 'completedBy',
          'points', 'isFinalMission', 'completedAt'
        ])
        && data.completedBy == request.auth.uid
        && data.gameSessionId == config.gameSessionId
        && data.team == get(userPath).data.team
        && get(userPath).data.status == 'ACTIVE'
        && exists(missionPath)
        && (!mission.keys().hasAny(['isFinalMission']) || mission.isFinalMission == data.isFinalMission)
        && data.points is int
        && data.points == mission.points
        && data.isFinalMission is bool
        && config.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE', 'FINAL_MISSION']
        && (
          (data.isFinalMission == true
            && config.gameStatus == 'FINAL_MISSION'
            && config.isFinalMissionActive == true
            && config.keys().hasAny(['activeFinalMissionId'])
            && config.activeFinalMissionId == data.missionId)
          || (data.isFinalMission == false
            && config.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE']
            && (
              (!config.keys().hasAny(['activeMissionA']) && !config.keys().hasAny(['activeMissionB']))
              || (data.team == 'A' && (!config.keys().hasAny(['activeMissionA']) || config.activeMissionA == data.missionId))
              || (data.team == 'B' && (!config.keys().hasAny(['activeMissionB']) || config.activeMissionB == data.missionId))
            ))
        )
        && (!data.keys().hasAny(['luckyReward']) || data.luckyReward is bool)
        && data.completedAt is timestamp
        && completionId == data.team + '_' + data.gameSessionId + '_' + data.missionId;
    }

    match /missionCompletions/{completionId} {
      allow read: if signedIn() && (isAdmin() || isCurrentParticipant(request.auth.uid));
      allow create: if isAdmin() || validMissionCompletionCreate(completionId);
      allow update, delete: if isAdmin();
    }

    function validLogEntry(entry, allowedTypes) {
      return entry is map
        && entry.keys().hasOnly(['id', 'timestamp', 'message', 'type'])
        && entry.keys().hasAll(['id', 'timestamp', 'message', 'type'])
        && entry.id is string
        && entry.id.size() > 0
        && entry.id.size() <= 100
        && entry.timestamp is int
        && entry.message is string
        && entry.message.size() > 0
        && entry.message.size() <= 300
        && entry.type in allowedTypes;
    }

    function validPrependedLogs(currentData, newData, allowedTypes) {
      let prevLogs = (currentData.keys().hasAny(['logs']) && currentData.logs is list) ? currentData.logs : [];
      return newData.logs is list
        && newData.logs.size() >= 1
        && newData.logs.size() <= 200
        && newData.logs.size() == (prevLogs.size() >= 200 ? 200 : prevLogs.size() + 1)
        && validLogEntry(newData.logs[0], allowedTypes)
        && (prevLogs.size() == 0 || newData.logs[1] == prevLogs[0]);
    }

    function validLogOnlyConfigUpdate(currentData, newData, diff) {
      return diff.hasOnly(['logs'])
        && diff.size() == 1
        && validPrependedLogs(currentData, newData, ['SYSTEM', 'EMERGENCY'])
        && newData.teamARole == currentData.teamARole
        && newData.teamBRole == currentData.teamBRole
        && newData.teamAScore == currentData.teamAScore
        && newData.teamBScore == currentData.teamBScore
        && (!currentData.keys().hasAny(['nextRevealTime']) || newData.nextRevealTime == currentData.nextRevealTime);
    }

    function validMissionScoreConfigUpdate(currentData, newData, diff) {
      let mePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let compPath = /databases/$(database)/documents/missionCompletions/$(getAfter(mePath).data.lastCompletionId);
      return existsAfter(mePath)
        && getAfter(mePath).data.keys().hasAny(['lastCompletionId'])
        && getAfter(mePath).data.lastCompletionId is string
        && !exists(compPath)
        && existsAfter(compPath)
        && getAfter(compPath).data.completedBy == request.auth.uid
        && getAfter(compPath).data.team == getAfter(mePath).data.team
        && getAfter(compPath).data.gameSessionId == currentData.gameSessionId
        && getAfter(compPath).data.points > 0
        && getAfter(compPath).data.points <= 100
        && newData.teamARole == currentData.teamARole
        && newData.teamBRole == currentData.teamBRole
        && (!currentData.keys().hasAny(['nextRevealTime']) || newData.nextRevealTime == currentData.nextRevealTime)
        && (!diff.hasAny(['logs']) || validPrependedLogs(currentData, newData, ['MISSION']))
        && (getAfter(mePath).data.team == 'A'
            ? (diff.hasOnly(['teamAScore', 'logs'])
               && newData.teamAScore == currentData.teamAScore + getAfter(compPath).data.points
               && newData.teamBScore == currentData.teamBScore)
            : (diff.hasOnly(['teamBScore', 'logs'])
               && newData.teamBScore == currentData.teamBScore + getAfter(compPath).data.points
               && newData.teamAScore == currentData.teamAScore));
    }

    function validCaptureConfigUpdate(currentData, newData, diff) {
      let mePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let targetPath = /databases/$(database)/documents/users/$(newData.lastCaptureTargetId);
      let nowMs = request.time.toMillis();
      let isSurvival = currentData.keys().hasAny(['victoryMode']) && currentData.victoryMode == 'SURVIVAL';
      return exists(mePath)
        && currentData.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE', 'FINAL_MISSION']
        && (get(mePath).data.team == 'A' ? currentData.teamARole : currentData.teamBRole) == 'ONI'
        && get(mePath).data.status == 'ACTIVE'
        && diff.hasOnly(['teamARole', 'teamBRole', 'teamAScore', 'teamBScore', 'nextRevealTime', 'lastCaptureTargetId', 'logs'])
        && (!isSurvival
            ? validCaptureWaitingBound(currentData, newData.nextRevealTime, nowMs)
            : (!currentData.keys().hasAny(['nextRevealTime'])
                ? (!newData.keys().hasAny(['nextRevealTime']) || newData.nextRevealTime is int)
                : newData.nextRevealTime == currentData.nextRevealTime))
        && (!currentData.keys().hasAny(['startTime']) || !(currentData.startTime is int) || nowMs >= currentData.startTime + 1800000)
        && newData.lastCaptureTargetId is string
        && exists(targetPath)
        && existsAfter(targetPath)
        && get(targetPath).data.gameSessionId == currentData.gameSessionId
        && get(targetPath).data.team in ['A', 'B']
        && get(targetPath).data.team != get(mePath).data.team
        && get(targetPath).data.status == 'ACTIVE'
        && (!get(targetPath).data.keys().hasAny(['invincibleUntil']) || !(get(targetPath).data.invincibleUntil is int) || get(targetPath).data.invincibleUntil <= nowMs)
        && (!get(targetPath).data.keys().hasAny(['protectionZone']) || get(targetPath).data.protectionZone == 'NONE')
        && (isSurvival
            ? (getAfter(targetPath).data.status == 'CAPTURED'
               && getAfter(targetPath).data.waitingUntil == 0
               && newData.teamARole == currentData.teamARole
               && newData.teamBRole == currentData.teamBRole
               && (get(mePath).data.team == 'A'
                   ? (newData.teamAScore == currentData.teamAScore + 50 && newData.teamBScore == currentData.teamBScore)
                   : (newData.teamBScore == currentData.teamBScore + 50 && newData.teamAScore == currentData.teamAScore)))
            : (getAfter(targetPath).data.status == 'WAITING'
               && getAfter(targetPath).data.waitingUntil is int
               && getAfter(targetPath).data.waitingUntil > nowMs
               && (getAfter(targetPath).data.waitingUntil <= nowMs + 1860000
                 || (currentData.keys().hasAny(['captureWaitMinutes'])
                   && currentData.captureWaitMinutes is int
                   && currentData.captureWaitMinutes >= 1
                   && currentData.captureWaitMinutes <= 120
                   && getAfter(targetPath).data.waitingUntil <= nowMs + currentData.captureWaitMinutes * 60000 + 60000))
               && getAfter(targetPath).data.waitingUntil <= nowMs + 7260000
               && (get(mePath).data.team == 'A'
                   ? (currentData.teamARole == 'ONI'
                      && newData.teamARole == 'RUNNER'
                      && newData.teamBRole == 'ONI'
                      && newData.teamAScore == currentData.teamAScore + 50
                      && newData.teamBScore == currentData.teamBScore)
                   : (currentData.teamBRole == 'ONI'
                      && newData.teamBRole == 'RUNNER'
                      && newData.teamARole == 'ONI'
                      && newData.teamBScore == currentData.teamBScore + 50
                      && newData.teamAScore == currentData.teamAScore))))
        && (!diff.hasAny(['logs']) || validPrependedLogs(currentData, newData, ['CAPTURE']));
    }

    function validParticipantConfigUpdate(configId) {
      let currentData = resource.data;
      let newData = request.resource.data;
      let diff = newData.diff(currentData).affectedKeys();
      return signedIn()
        && configId == 'current'
        && isCurrentParticipant(request.auth.uid)
        && hasCurrentGameSession()
        && newData.gameSessionId == currentData.gameSessionId
        && newData.sessionStartedAt == currentData.sessionStartedAt
        && newData.sessionSchemaVersion == currentData.sessionSchemaVersion
        && newData.gameStatus == currentData.gameStatus
        && newData.day == currentData.day
        && newData.missionMode == currentData.missionMode
        && newData.isGameOver == currentData.isGameOver
        && (
          (diff.hasOnly(['logs']) && validLogOnlyConfigUpdate(currentData, newData, diff))
          || (diff.hasAny(['teamARole', 'teamBRole', 'lastCaptureTargetId']) && validCaptureConfigUpdate(currentData, newData, diff))
          || (diff.hasAny(['teamAScore', 'teamBScore']) && validMissionScoreConfigUpdate(currentData, newData, diff))
        );
    }

    match /game_config/{configId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validParticipantConfigUpdate(configId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
