rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap this document once from the Firebase Console after creating
    // the administrator Auth account. Do not allow clients to create it.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }


    function ownerStatusChangeIsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']);
    }

    function userDocumentHasNoCoordinateFields() {
      return !request.resource.data.keys().hasAny([
        'privateLatitude', 'privateLongitude', 'latitude', 'longitude',
        'lastLat', 'lastLng', 'exposedLat', 'exposedLng', 'locationExposedUntil'
      ]);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /privateLocations/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'updatedAt'])
        && request.resource.data.keys().hasAll(['latitude', 'longitude', 'updatedAt'])
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    function isRevealViewer() {
      return signedIn() && (isAdmin()
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.team in ['A', 'B']));
    }

    function validExposedLocation(uid) {
      let data = resource.data;
      let playerPath = /databases/$(database)/documents/users/$(uid);
      let configPath = /databases/$(database)/documents/game_config/current;
      return exists(configPath)
        && get(configPath).data.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE']
        && data.keys().hasOnly([
          'playerId', 'latitude', 'longitude', 'capturedAt', 'expiresAt', 'revealScope'
        ])
        && data.keys().hasAll(['latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.capturedAt is timestamp
        && data.expiresAt is timestamp
        && request.time < data.expiresAt
        && (!data.keys().hasAny(['playerId']) || data.playerId == uid)
        && exists(playerPath)
        && get(playerPath).data.team in ['A', 'B']
        && get(playerPath).data.status != 'EMERGENCY'
        && get(playerPath).data.status != 'RETIRED'
        && ((!data.keys().hasAny(['revealScope']))
          || (data.revealScope == 'GLOBAL'
            && exists(configPath)
            && get(configPath).data.locationRevealUntil is timestamp
            && request.time < get(configPath).data.locationRevealUntil)
          || (data.revealScope == 'TEAM_A'
            && get(playerPath).data.team == 'A'
            && exists(configPath)
            && get(configPath).data.teamARevealUntil is timestamp
            && request.time < get(configPath).data.teamARevealUntil)
          || (data.revealScope == 'TEAM_B'
            && get(playerPath).data.team == 'B'
            && exists(configPath)
            && get(configPath).data.teamBRevealUntil is timestamp
            && request.time < get(configPath).data.teamBRevealUntil));
    }

    function validOwnerExposedLocationWrite(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.capturedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.time < request.resource.data.expiresAt
        && request.resource.data.expiresAt <= request.time + duration.value(5, 'm')
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.team in ['A', 'B']
        && get(/databases/$(database)/documents/users/$(uid)).data.status != 'EMERGENCY'
        && get(/databases/$(database)/documents/users/$(uid)).data.status != 'RETIRED'
        && exists(/databases/$(database)/documents/game_config/current)
        && get(/databases/$(database)/documents/game_config/current).data.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE'];
    }

    function ownerMayReplaceSnapshot() {
      return !resource.data.keys().hasAny(['revealScope'])
        || resource.data.revealScope == 'INDIVIDUAL'
        || !(resource.data.expiresAt is timestamp)
        || resource.data.expiresAt <= request.time;
    }

    match /exposedLocations/{uid} {
      allow get: if isRevealViewer()
        && (!exists(/databases/$(database)/documents/exposedLocations/$(uid))
          || validExposedLocation(uid));
      allow list: if false;
      allow create: if validOwnerExposedLocationWrite(uid);
      allow update: if validOwnerExposedLocationWrite(uid) && ownerMayReplaceSnapshot();
      allow delete: if false;
    }

    function validEmergencyProjection(uid) {
      return resource.data.keys().hasOnly([
          'playerId', 'latitude', 'longitude', 'projectedAt',
          'sourceLocationUpdatedAt', 'expiresAt', 'safetyStatus', 'projectionKind'
        ])
        && resource.data.keys().hasAll([
          'playerId', 'latitude', 'longitude', 'projectedAt',
          'sourceLocationUpdatedAt', 'expiresAt', 'safetyStatus', 'projectionKind'
        ])
        && resource.data.playerId == uid
        && resource.data.latitude is number
        && resource.data.latitude >= -90
        && resource.data.latitude <= 90
        && resource.data.longitude is number
        && resource.data.longitude >= -180
        && resource.data.longitude <= 180
        && resource.data.projectedAt is timestamp
        && resource.data.sourceLocationUpdatedAt is timestamp
        && resource.data.expiresAt is timestamp
        && resource.data.sourceLocationUpdatedAt <= resource.data.projectedAt
        && resource.data.expiresAt > resource.data.projectedAt
        && resource.data.expiresAt > request.time
        && resource.data.safetyStatus == 'EMERGENCY'
        && resource.data.projectionKind == 'EMERGENCY'
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'EMERGENCY';
    }

    match /emergencyLocationProjections/{uid} {
      allow get: if isAdmin()
        && (!exists(/databases/$(database)/documents/emergencyLocationProjections/$(uid))
          || validEmergencyProjection(uid));
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.team in ['A', 'B']
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.score == 0
        && request.resource.data.invincibleCards == 0
        && (!request.resource.data.keys().hasAny(['invincibleUntil'])
          || request.resource.data.invincibleUntil == 0)
        && (!request.resource.data.keys().hasAny(['waitingUntil'])
          || request.resource.data.waitingUntil == 0)
        && (!request.resource.data.keys().hasAny(['shinkansenStartTime'])
          || request.resource.data.shinkansenStartTime == null)
        && userDocumentHasNoCoordinateFields();
      // Player-owned profile updates remain available, but status and
      // authoritative gameplay fields are writable only by trusted actions.
      allow update: if (isAdmin() && userDocumentHasNoCoordinateFields())
        || (signedIn() && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'score', 'team', 'invincibleCards', 'invincibleUntil',
            'waitingUntil', 'shinkansenStartTime'
          ])
          && ownerStatusChangeIsValid()
          && userDocumentHasNoCoordinateFields());
      allow delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /missionCompletions/{completionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    function revealDeadlinesAreClear(data) {
      return (!data.keys().hasAny(['locationRevealUntil'])
          || data.locationRevealUntil == null || data.locationRevealUntil == 0)
        && (!data.keys().hasAny(['teamARevealUntil'])
          || data.teamARevealUntil == null || data.teamARevealUntil == 0)
        && (!data.keys().hasAny(['teamBRevealUntil'])
          || data.teamBRevealUntil == null || data.teamBRevealUntil == 0);
    }

    function revealDeadlineIsUnchangedOrClear(oldData, newData, field) {
      return !newData.keys().hasAny([field])
        || newData[field] == null
        || newData[field] == 0
        || (oldData.keys().hasAny([field]) && newData[field] == oldData[field]);
    }

    function revealDeadlinesAreUnchangedOrClear(oldData, newData) {
      return revealDeadlineIsUnchangedOrClear(oldData, newData, 'locationRevealUntil')
        && revealDeadlineIsUnchangedOrClear(oldData, newData, 'teamARevealUntil')
        && revealDeadlineIsUnchangedOrClear(oldData, newData, 'teamBRevealUntil');
    }

    match /game_config/{configId} {
      allow read: if signedIn();
      allow create: if isAdmin() && revealDeadlinesAreClear(request.resource.data);
      allow update: if isAdmin()
        && revealDeadlinesAreUnchangedOrClear(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
