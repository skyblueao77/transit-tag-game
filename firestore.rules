rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap this document once from the Firebase Console after creating
    // the administrator Auth account.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasCurrentGameSession() {
      let configPath = /databases/$(database)/documents/game_config/current;
      return exists(configPath)
        && get(configPath).data.gameSessionId is string
        && get(configPath).data.gameSessionId.size() > 0
        && get(configPath).data.sessionStartedAt is int
        && get(configPath).data.sessionStartedAt >= 0
        && get(configPath).data.sessionSchemaVersion is int
        && get(configPath).data.sessionSchemaVersion >= 2;
    }

    function validPlayerCreate(uid) {
      let configPath = /databases/$(database)/documents/game_config/current;
      let data = request.resource.data;
      return signedIn()
        && !isAdmin()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && data.keys().hasOnly([
          'id', 'name', 'role', 'team', 'color', 'score', 'status',
          'gameSessionId', 'invincibleCards'
        ])
        && data.keys().hasAll([
          'id', 'name', 'role', 'team', 'color', 'score', 'status',
          'gameSessionId', 'invincibleCards'
        ])
        && data.id == uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.role == 'RUNNER'
        && data.team in ['A', 'B']
        && data.color is string
        && data.status == 'ACTIVE'
        && data.score is int
        && data.score == 0
        && data.invincibleCards is int
        && data.invincibleCards == 0
        && data.gameSessionId == get(configPath).data.gameSessionId;
    }

    function isCurrentParticipant(uid) {
      return signedIn()
        && hasCurrentGameSession()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.team in ['A', 'B']
        && get(/databases/$(database)/documents/users/$(uid)).data.gameSessionId
          == get(/databases/$(database)/documents/game_config/current).data.gameSessionId;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /{subCollection=**} {
        allow read, write: if signedIn() && request.auth.uid == uid && isAdmin();
      }
    }

    match /privateLocations/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && request.resource.data.keys().hasOnly(['gameSessionId', 'latitude', 'longitude', 'updatedAt'])
        && request.resource.data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'updatedAt'])
        && request.resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    function isRevealViewer() {
      return signedIn() && (isAdmin() || isCurrentParticipant(request.auth.uid));
    }

    function validExposedLocation(uid) {
      let data = resource.data;
      let playerPath = /databases/$(database)/documents/users/$(uid);
      let configPath = /databases/$(database)/documents/game_config/current;
      return exists(configPath)
        && get(configPath).data.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE']
        && data.keys().hasOnly([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt', 'revealScope'
        ])
        && hasCurrentGameSession()
        && data.gameSessionId == get(configPath).data.gameSessionId
        && data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.capturedAt is timestamp
        && data.expiresAt is timestamp
        && request.time < data.expiresAt
        && (!data.keys().hasAny(['playerId']) || data.playerId == uid)
        && isCurrentParticipant(uid)
        && get(playerPath).data.status != 'EMERGENCY'
        && get(playerPath).data.status != 'RETIRED'
        && ((!data.keys().hasAny(['revealScope']))
          || (data.revealScope == 'GLOBAL'
            && exists(configPath)
            && get(configPath).data.locationRevealUntil is timestamp
            && request.time < get(configPath).data.locationRevealUntil)
          || (data.revealScope == 'TEAM_A'
            && get(playerPath).data.team == 'A'
            && exists(configPath)
            && get(configPath).data.teamARevealUntil is timestamp
            && request.time < get(configPath).data.teamARevealUntil)
          || (data.revealScope == 'TEAM_B'
            && get(playerPath).data.team == 'B'
            && exists(configPath)
            && get(configPath).data.teamBRevealUntil is timestamp
            && request.time < get(configPath).data.teamBRevealUntil));
    }

    function validOwnerExposedLocationWrite(uid) {
      return signedIn()
        && !isAdmin()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && request.resource.data.keys().hasOnly(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && request.resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.capturedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.time < request.resource.data.expiresAt
        && request.resource.data.expiresAt <= request.time + duration.value(5, 'm')
        && isCurrentParticipant(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.status != 'EMERGENCY'
        && get(/databases/$(database)/documents/users/$(uid)).data.status != 'RETIRED'
        && exists(/databases/$(database)/documents/game_config/current)
        && get(/databases/$(database)/documents/game_config/current).data.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE'];
    }

    function ownerMayReplaceSnapshot() {
      return !resource.data.keys().hasAny(['gameSessionId'])
        || !hasCurrentGameSession()
        || resource.data.gameSessionId != get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        || !resource.data.keys().hasAny(['revealScope'])
        || resource.data.revealScope == 'INDIVIDUAL'
        || !(resource.data.expiresAt is timestamp)
        || resource.data.expiresAt <= request.time;
    }

    match /exposedLocations/{uid} {
      allow get: if isRevealViewer()
        && (!exists(/databases/$(database)/documents/exposedLocations/$(uid))
          || validExposedLocation(uid));
      allow list: if isAdmin();
      allow create: if validOwnerExposedLocationWrite(uid) || isAdmin();
      allow update: if (validOwnerExposedLocationWrite(uid) && ownerMayReplaceSnapshot()) || isAdmin();
      allow delete: if isAdmin();
    }

    function validEmergencyProjectionWrite(uid) {
      return signedIn()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && request.resource.data.keys().hasOnly([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'projectedAt',
          'sourceLocationUpdatedAt', 'expiresAt', 'safetyStatus', 'projectionKind'
        ])
        && request.resource.data.keys().hasAll([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'projectedAt',
          'sourceLocationUpdatedAt', 'expiresAt', 'safetyStatus', 'projectionKind'
        ])
        && request.resource.data.playerId == uid
        && request.resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        && request.resource.data.safetyStatus == 'EMERGENCY'
        && request.resource.data.projectionKind == 'EMERGENCY'
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.status == 'EMERGENCY'
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.projectedAt is timestamp
        && request.resource.data.sourceLocationUpdatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
    }

    match /emergencyLocationProjections/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if validEmergencyProjectionWrite(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    function validSelfUserUpdate(uid) {
      let b = resource.data;
      let a = request.resource.data;
      let diff = a.diff(b).affectedKeys();
      let nowMs = request.time.toMillis();
      return signedIn()
        && request.auth.uid == uid
        && a.id == b.id
        && a.team == b.team
        && a.role == b.role
        && a.gameSessionId == b.gameSessionId
        && (
          // 1. Profile name update
          (diff.hasOnly(['name']) && a.name is string && a.name.size() > 0 && a.name.size() <= 80)
          // 2. Waiting resume upon expiry
          || (b.status == 'WAITING' && a.status == 'ACTIVE'
              && b.waitingUntil is int && b.waitingUntil <= nowMs
              && a.waitingUntil == 0
              && diff.hasOnly(['status', 'waitingUntil', 'shinkansenStartTime']))
          // 3. Manual waiting start (60 min max duration + 60s tolerance)
          || (b.status == 'ACTIVE' && a.status == 'WAITING'
              && a.waitingUntil is int && a.waitingUntil > nowMs
              && a.waitingUntil <= nowMs + 3660000
              && diff.hasOnly(['status', 'waitingUntil', 'shinkansenStartTime']))
          // 4. Powerup invincibility card use (10 min max duration + 60s tolerance)
          || (b.invincibleCards is int && b.invincibleCards >= 1
              && a.invincibleCards == b.invincibleCards - 1
              && a.invincibleUntil is int && a.invincibleUntil > nowMs
              && a.invincibleUntil <= nowMs + 660000
              && diff.hasOnly(['invincibleCards', 'invincibleUntil']))
          // 5. Safety action: Emergency or Retire
          || (a.status in ['EMERGENCY', 'RETIRED']
              && a.waitingUntil == 0
              && a.invincibleUntil == 0
              && diff.hasOnly(['status', 'waitingUntil', 'shinkansenStartTime', 'invincibleUntil']))
          // 6. Mission completion reward (bounded score & card increment)
          || (a.score is int && a.score >= b.score && a.score <= b.score + 100
              && a.invincibleCards is int && a.invincibleCards >= b.invincibleCards && a.invincibleCards <= b.invincibleCards + 1
              && diff.hasOnly(['score', 'invincibleCards']))
        );
    }

    function validParticipantCaptureUpdate(uid) {
      let b = resource.data;
      let a = request.resource.data;
      let diff = a.diff(b).affectedKeys();
      let configPath = /databases/$(database)/documents/game_config/current;
      let curConfig = get(configPath).data;
      let afterConfig = getAfter(configPath).data;
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let myRole = me.team == 'A' ? curConfig.teamARole : curConfig.teamBRole;
      return signedIn()
        && isCurrentParticipant(request.auth.uid)
        && a.id == b.id
        && a.name == b.name
        && a.team == b.team
        && a.role == b.role
        && a.score == b.score
        && a.gameSessionId == b.gameSessionId
        && curConfig.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE']
        && myRole == 'ONI'
        && afterConfig.teamARole != curConfig.teamARole
        && !(b.invincibleUntil is int && b.invincibleUntil > request.time.toMillis())
        && diff.hasOnly(['status', 'waitingUntil', 'invincibleUntil', 'invincibleCards'])
        && a.status in ['WAITING', 'ACTIVE'];
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if validPlayerCreate(uid) || isAdmin();
      allow update: if isAdmin() || validSelfUserUpdate(uid) || validParticipantCaptureUpdate(uid);
      allow delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    function validMissionCompletionCreate() {
      let data = request.resource.data;
      let configPath = /databases/$(database)/documents/game_config/current;
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let missionPath = /databases/$(database)/documents/missions/$(data.missionId);
      return signedIn()
        && isCurrentParticipant(request.auth.uid)
        && hasCurrentGameSession()
        && data.keys().hasOnly([
          'gameSessionId', 'missionId', 'team', 'completedBy',
          'points', 'luckyReward', 'isFinalMission', 'completedAt'
        ])
        && data.keys().hasAll([
          'gameSessionId', 'missionId', 'team', 'completedBy',
          'points', 'isFinalMission', 'completedAt'
        ])
        && data.completedBy == request.auth.uid
        && data.gameSessionId == get(configPath).data.gameSessionId
        && data.team == get(userPath).data.team
        && get(userPath).data.status == 'ACTIVE'
        && exists(missionPath)
        && data.points is int
        && data.points == get(missionPath).data.points
        && data.isFinalMission is bool
        && (data.isFinalMission == false
            || (get(configPath).data.keys().hasAny(['activeFinalMissionId'])
                && get(configPath).data.activeFinalMissionId == data.missionId))
        && data.completedAt is timestamp;
    }

    match /missionCompletions/{completionId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (validMissionCompletionCreate()
        && completionId.matches('^' + request.resource.data.team + '_[A-Za-z0-9_-]+$'));
      allow update, delete: if isAdmin();
    }

    function validParticipantConfigUpdate(configId) {
      let currentData = resource.data;
      let newData = request.resource.data;
      return signedIn()
        && configId == 'current'
        && isCurrentParticipant(request.auth.uid)
        && hasCurrentGameSession()
        && newData.gameSessionId == currentData.gameSessionId
        && newData.sessionStartedAt == currentData.sessionStartedAt
        && newData.sessionSchemaVersion == currentData.sessionSchemaVersion
        && newData.gameStatus == currentData.gameStatus
        && newData.day == currentData.day
        && newData.missionMode == currentData.missionMode
        && newData.isGameOver == currentData.isGameOver
        && newData.diff(currentData).affectedKeys().hasOnly([
          'teamARole', 'teamBRole', 'nextRevealTime', 'teamAScore', 'teamBScore', 'logs'
        ])
        && (newData.logs is list && newData.logs.size() <= 200)
        && (newData.teamAScore is int && newData.teamAScore >= currentData.teamAScore && newData.teamAScore <= currentData.teamAScore + 100)
        && (newData.teamBScore is int && newData.teamBScore >= currentData.teamBScore && newData.teamBScore <= currentData.teamBScore + 100)
        && (
          (newData.teamARole == currentData.teamARole && newData.teamBRole == currentData.teamBRole)
          || (newData.teamARole in ['ONI', 'RUNNER'] && newData.teamBRole in ['ONI', 'RUNNER'] && newData.teamARole != newData.teamBRole)
        );
    }

    match /game_config/{configId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validParticipantConfigUpdate(configId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
