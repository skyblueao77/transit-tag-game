rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap this document once from the Firebase Console after creating
    // the administrator Auth account. Do not allow clients to create it.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasCurrentGameSession() {
      let configPath = /databases/$(database)/documents/game_config/current;
      return exists(configPath)
        && get(configPath).data.gameSessionId is string
        && get(configPath).data.gameSessionId.size() > 0
        && get(configPath).data.sessionStartedAt is int
        && get(configPath).data.sessionStartedAt >= 0
        && get(configPath).data.sessionSchemaVersion is int
        && get(configPath).data.sessionSchemaVersion >= 2;
    }

    function validPlayerCreate(uid) {
      let configPath = /databases/$(database)/documents/game_config/current;
      let data = request.resource.data;
      return signedIn()
        && !isAdmin()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && data.keys().hasOnly([
          'id', 'name', 'role', 'team', 'color', 'score', 'status',
          'gameSessionId', 'invincibleCards'
        ])
        && data.keys().hasAll([
          'id', 'name', 'role', 'team', 'color', 'score', 'status',
          'gameSessionId', 'invincibleCards'
        ])
        && data.id == uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.role == 'RUNNER'
        && data.team in ['A', 'B']
        && data.color is string
        && data.status == 'ACTIVE'
        && data.score is int
        && data.score == 0
        && data.invincibleCards is int
        && data.invincibleCards == 0
        && data.gameSessionId == get(configPath).data.gameSessionId;
    }

    function validOwnerProfileUpdate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    function isCurrentParticipant(uid) {
      return signedIn()
        && hasCurrentGameSession()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.team in ['A', 'B']
        && get(/databases/$(database)/documents/users/$(uid)).data.gameSessionId
          == get(/databases/$(database)/documents/game_config/current).data.gameSessionId;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /privateLocations/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && request.resource.data.keys().hasOnly(['gameSessionId', 'latitude', 'longitude', 'updatedAt'])
        && request.resource.data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'updatedAt'])
        && request.resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    function isRevealViewer() {
      return signedIn() && (isAdmin() || isCurrentParticipant(request.auth.uid));
    }

    function validExposedLocation(uid) {
      let data = resource.data;
      let playerPath = /databases/$(database)/documents/users/$(uid);
      let configPath = /databases/$(database)/documents/game_config/current;
      return exists(configPath)
        && get(configPath).data.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE']
        && data.keys().hasOnly([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt', 'revealScope'
        ])
        && hasCurrentGameSession()
        && data.gameSessionId == get(configPath).data.gameSessionId
        && data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.capturedAt is timestamp
        && data.expiresAt is timestamp
        && request.time < data.expiresAt
        && (!data.keys().hasAny(['playerId']) || data.playerId == uid)
        && isCurrentParticipant(uid)
        && get(playerPath).data.status != 'EMERGENCY'
        && get(playerPath).data.status != 'RETIRED'
        && ((!data.keys().hasAny(['revealScope']))
          || (data.revealScope == 'GLOBAL'
            && exists(configPath)
            && get(configPath).data.locationRevealUntil is timestamp
            && request.time < get(configPath).data.locationRevealUntil)
          || (data.revealScope == 'TEAM_A'
            && get(playerPath).data.team == 'A'
            && exists(configPath)
            && get(configPath).data.teamARevealUntil is timestamp
            && request.time < get(configPath).data.teamARevealUntil)
          || (data.revealScope == 'TEAM_B'
            && get(playerPath).data.team == 'B'
            && exists(configPath)
            && get(configPath).data.teamBRevealUntil is timestamp
            && request.time < get(configPath).data.teamBRevealUntil));
    }

    function validOwnerExposedLocationWrite(uid) {
      return signedIn()
        && !isAdmin()
        && request.auth.uid == uid
        && hasCurrentGameSession()
        && request.resource.data.keys().hasOnly(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['gameSessionId', 'latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && request.resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.capturedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.time < request.resource.data.expiresAt
        && request.resource.data.expiresAt <= request.time + duration.value(5, 'm')
        && isCurrentParticipant(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.status != 'EMERGENCY'
        && get(/databases/$(database)/documents/users/$(uid)).data.status != 'RETIRED'
        && exists(/databases/$(database)/documents/game_config/current)
        && get(/databases/$(database)/documents/game_config/current).data.gameStatus in ['DAY1_ACTIVE', 'DAY2_ACTIVE'];
    }

    function ownerMayReplaceSnapshot() {
      return !resource.data.keys().hasAny(['gameSessionId'])
        || !hasCurrentGameSession()
        || resource.data.gameSessionId != get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        || !resource.data.keys().hasAny(['revealScope'])
        || resource.data.revealScope == 'INDIVIDUAL'
        || !(resource.data.expiresAt is timestamp)
        || resource.data.expiresAt <= request.time;
    }

    match /exposedLocations/{uid} {
      allow get: if isRevealViewer()
        && (!exists(/databases/$(database)/documents/exposedLocations/$(uid))
          || validExposedLocation(uid));
      allow list: if false;
      allow create: if validOwnerExposedLocationWrite(uid);
      allow update: if validOwnerExposedLocationWrite(uid) && ownerMayReplaceSnapshot();
      allow delete: if false;
    }

    function validEmergencyProjection(uid) {
      return hasCurrentGameSession()
        && resource.data.keys().hasOnly([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'projectedAt',
          'sourceLocationUpdatedAt', 'expiresAt', 'safetyStatus', 'projectionKind'
        ])
        && resource.data.keys().hasAll([
          'playerId', 'gameSessionId', 'latitude', 'longitude', 'projectedAt',
          'sourceLocationUpdatedAt', 'expiresAt', 'safetyStatus', 'projectionKind'
        ])
        && resource.data.gameSessionId == get(/databases/$(database)/documents/game_config/current).data.gameSessionId
        && resource.data.playerId == uid
        && resource.data.latitude is number
        && resource.data.latitude >= -90
        && resource.data.latitude <= 90
        && resource.data.longitude is number
        && resource.data.longitude >= -180
        && resource.data.longitude <= 180
        && resource.data.projectedAt is timestamp
        && resource.data.sourceLocationUpdatedAt is timestamp
        && resource.data.expiresAt is timestamp
        && resource.data.sourceLocationUpdatedAt <= resource.data.projectedAt
        && resource.data.expiresAt > resource.data.projectedAt
        && resource.data.expiresAt > request.time
        && resource.data.safetyStatus == 'EMERGENCY'
        && resource.data.projectionKind == 'EMERGENCY'
        && isCurrentParticipant(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'EMERGENCY';
    }

    match /emergencyLocationProjections/{uid} {
      allow get: if isAdmin()
        && (!exists(/databases/$(database)/documents/emergencyLocationProjections/$(uid))
          || validEmergencyProjection(uid));
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if validPlayerCreate(uid);
      allow update: if validOwnerProfileUpdate(uid);
      allow delete: if false;
    }

    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /missionCompletions/{completionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /game_config/{configId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
