rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap this document once from the Firebase Console after creating
    // the administrator Auth account. Do not allow clients to create it.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /privateLocations/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'updatedAt'])
        && request.resource.data.keys().hasAll(['latitude', 'longitude', 'updatedAt'])
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /exposedLocations/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (request.auth.uid == uid || isAdmin())
        && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['latitude', 'longitude', 'capturedAt', 'expiresAt'])
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.capturedAt is timestamp
        && request.resource.data.expiresAt is number;
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.team in ['A', 'B']
        && !request.resource.data.keys().hasAny(['lastLat', 'lastLng', 'exposedLat', 'exposedLng', 'locationExposedUntil']);
      // This preserves the current client architecture while protecting
      // game-wide configuration and other players from non-admin writes.
      allow update: if (isAdmin() && !request.resource.data.keys().hasAny(['lastLat', 'lastLng', 'exposedLat', 'exposedLng', 'locationExposedUntil']))
        || (signedIn() && request.auth.uid == uid
          && !request.resource.data.keys().hasAny(['lastLat', 'lastLng', 'exposedLat', 'exposedLng', 'locationExposedUntil']));
      allow delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /game_config/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
