{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!**/functions", "!!src/data/stations.json"],
		"maxSize": 4194304
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"preset": "recommended",
				"useButtonType": "warn",
				"noLabelWithoutControl": "warn",
				"useAriaPropsSupportedByRole": "warn"
			},
			"complexity": {
				"noImportantStyles": "off",
				"useOptionalChain": "warn"
			},
			"correctness": {
				"noUnusedImports": "warn",
				"useExhaustiveDependencies": "warn",
				"noUnusedFunctionParameters": "warn",
				"noUnusedVariables": "warn"
			},
			"style": {
				"useNodejsImportProtocol": "warn"
			},
			"suspicious": {
				"noExplicitAny": "warn"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
