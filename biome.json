{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!**/functions"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"recommended": false
			},
			"complexity": {
				"noImportantStyles": "off",
				"useOptionalChain": "warn"
			},
			"correctness": {
				"noUnusedImports": "warn",
				"useExhaustiveDependencies": "off",
				"noUnusedFunctionParameters": "warn",
				"noUnusedVariables": "warn"
			},
			"style": {
				"useNodejsImportProtocol": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
