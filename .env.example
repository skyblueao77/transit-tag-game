# Firebase Web App configuration
# Copy this file to .env.local and replace every value with your own Firebase project values.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase App Check (reCAPTCHA Enterprise Site Key - Public)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# Local Development Only (Set to "true" or registered debug token in .env.local; leave empty in production)
VITE_APPCHECK_DEBUG_TOKEN=
